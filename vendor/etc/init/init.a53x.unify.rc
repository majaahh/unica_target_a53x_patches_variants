# SC-53C - a53xdcm - jpn_dcm
on early-init && property:ro.boot.em.model=SC-53C
    # TEEgris - Firmware
    mount none /vendor/tee_SC-53C /vendor/tee bind

# SCG15 - a53xkdi - jpn_kdi
on early-init && property:ro.boot.em.model=SCG15
    # TEEgris - Firmware
    mount none /vendor/tee_SCG15 /vendor/tee bind

# SM-A5360 - a53xzc - chn_open
on early-init && property:ro.boot.em.model=SM-A5360
    # TEEgris - Firmware
    mount none /vendor/tee_SM-A5360 /vendor/tee bind

# SM-A536E - a53xnsxx - cis_open
on early-init && property:ro.boot.em.model=SM-A536E
    # TEEgris - Firmware
    mount none /vendor/tee_SM-A536E /vendor/tee bind

# SM-A536N - kor_open
on early-init && property:ro.boot.em.model=SM-A536N
    # TEEgris - Firmware
    mount none /vendor/tee_SM-A536N /vendor/tee bind

# Firmware blobs
on early-init
    # Firmware blobs
    mount none /vendor/firmware/${ro.boot.em.model}/AP_AUDIO_SLSI.bin /vendor/firmware/AP_AUDIO_SLSI.bin bind
    mount none /vendor/firmware/${ro.boot.em.model}/APDV_AUDIO_SLSI.bin /vendor/firmware/APDV_AUDIO_SLSI.bin bind
    mount none /vendor/firmware/${ro.boot.em.model}/mfc_fw.bin /vendor/firmware/mfc_fw.bin bind
    mount none /vendor/firmware/${ro.boot.em.model}/NPU.bin /vendor/firmware/NPU.bin bind
    mount none /vendor/firmware/${ro.boot.em.model}/os.checked.bin /vendor/firmware/os.checked.bin bind
    mount none /vendor/firmware/${ro.boot.em.model}/vts.bin /vendor/firmware/vts.bin bind
    mount none /vendor/firmware/${ro.boot.em.model}/calliope_sram.bin /vendor/firmware/calliope_sram.bin bind

on boot
    restart audioserver
