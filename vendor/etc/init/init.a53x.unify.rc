# a53xksx (kor_open)
on early-init && property:ro.boot.em.model=SM-A536N
    # Firmware blobs
    mount none /vendor/firmware/SM-A536N/AP_AUDIO_SLSI.bin /vendor/firmware/AP_AUDIO_SLSI.bin bind
    mount none /vendor/firmware/SM-A536N/APDV_AUDIO_SLSI.bin /vendor/firmware/APDV_AUDIO_SLSI.bin bind
    mount none /vendor/firmware/SM-A536N/mfc_fw.bin /vendor/firmware/mfc_fw.bin bind
    mount none /vendor/firmware/SM-A536N/NPU.bin /vendor/firmware/NPU.bin bind
    mount none /vendor/firmware/SM-A536N/os.checked.bin /vendor/firmware/os.checked.bin bind
